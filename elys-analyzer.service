[Unit]
Description=Elysium Analyzer Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/root/elysium-analyzer-bot
ExecStart=/root/elysium-analyzer-bot/venv/bin/python /root/elysium-analyzer-bot/bot.py
Restart=always
RestartSec=5
# never let the bot starve the server (other bots, SSH): cap its memory and CPU; over the cap it restarts
MemoryHigh=600M
MemoryMax=800M
CPUQuota=80%
Nice=5

[Install]
WantedBy=multi-user.target
