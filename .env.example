# Token of the NEW analyzer bot from @BotFather
BOT_TOKEN=
# Your Telegram id (optional: otherwise the first person to /start the bot becomes admin)
OWNER_ID=

# Elysium mainnet — same nodes as the Degen trade bot
CHAIN_ID=99901
RPC_URLS=https://rpc.thekleos.xyz,https://rpc-live.boxa.club,https://rpc.thekleos.pro/rpc,https://rpc-live.elyspump.com,https://rpc-live.elysp.com
EXPLORER_URL=https://elyscan.live
# Blockscout API of the explorer for holders on the scan card (empty = off)
EXPLORER_API=https://elyscan.live/api/v2
# Trading venues, same format as in the trade bot. Empty = built-in list (Kleos, ElysPump, Boxa, ELYXA, Obol, Montra, Stockium, Uniswap…)
ROUTERS=

# Buy buttons under every post
DEGEN_BOT=elysiumdegen_bot
# Your referral code in Degen bot (🤝 Referrals), optional
DEGEN_REF=
BASED_BOT=based_eth_bot
BASED_REF=r_Ramram
# How Based bot opens one token (its Shill-link format r_<ref>_b_<token>): {ref} {token} {hex} are replaced
BASED_TOKEN_PARAM={ref}_b_{token}

# New deploys channel: bot must be channel admin; or set with /setdeploys @channel
DEPLOY_CHANNEL=@elysium_deploys
# Seconds to wait for a new token's pool before deciding it isn't a memepad launch
DEPLOY_ROUTE_WAIT=90
# Edit the post once after N seconds (dev buy, MC). 0 = off
DEPLOY_REFRESH=25
# 1 = also post new tokens that aren't on a memepad
DEPLOY_POST_ALL=0
# Once on start: read mint logs of the last N blocks so older dev deploys are counted (0 = off)
BACKFILL_BLOCKS=0
# Extra launch contracts (tx target → label), see /pads: 0xabc…=NEWPAD,0xdef…=OTHER
PAD_FACTORIES=
# Token page per pad, if not built in: OBOL=https://…/{token},BOXA=https://…/{token}
PAD_PAGES=

# Group alerts (forum topics): MC milestones in $, dips
MCAP_LEVELS=10000,20000,30000,50000,100000
DIP_PCT=15
DIP_WINDOW_MIN=60
DIP_COOLDOWN_MIN=60
DIP_MIN_LIQ=300
# Pools that don't report liquidity (Uniswap v4, pad curves): dips only for tokens with MC above this ($)
DIP_MIN_MC=5000
# Memepad tokens are watched for TRACK_DAYS after launch, and after that while MC ≥ TRACK_MIN_MC
TRACK_SECONDS=60
TRACK_DAYS=3
TRACK_MIN_MC=3000
TRACK_MAX=400

# Big buys topic (/settopic bigbuy): buys of at least this many HYPE
BIGBUY_HYPE=10

# Daily top-5 gainers / top-3 losers (/settopic daily)
DIGEST_TIME=18:00
DIGEST_TZ=Europe/Minsk
DIGEST_MIN_MC=3000

# Background work (deploys feed, tracker, big buys, volume) uses its own node connection with at most this many
# requests at once, so scans and commands stay fast
BG_RPC_INFLIGHT=12

# Public nodes limit log searches (eth_getLogs) per IP per minute; the bot spreads them over all RPC_URLS at
# this pace per node and pauses a node for a minute when it says "too many"
LOGS_PER_MIN_PER_NODE=40
